# =============================================================================
# FastReID Embedding Service — Variables de entorno
# Copiar a .env y completar antes de iniciar el servicio
# =============================================================================

# Entorno: development | production
APP_ENV=production

# API Key interna — generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CAMBIAR_POR_TOKEN_SEGURO

# Logging
LOG_LEVEL=INFO

# Rutas de pesos
MODEL_PATH_PERSON=weights/person_model.pth
MODEL_PATH_VEHICLE=weights/vehicle_model.pth
MODEL_ONNX_PATH_PERSON=weights/person_model.onnx
MODEL_ONNX_PATH_VEHICLE=weights/vehicle_model.onnx
ENABLE_ONNX=true

# Rutas de configs FastReID
FASTREID_CONFIG_PERSON=configs/msmt17_sbs_R101ibn_person.yml
FASTREID_CONFIG_VEHICLE=configs/sbs_R50ibn_vehicle.yml

# Nombres de modelo en respuesta JSON
MODEL_NAME_PERSON=msmt17_sbs_R101-ibn
MODEL_NAME_VEHICLE=sbs_R50-ibn_vehicle

# Dimensión de embedding (ResNet50 = 2048)
EMBEDDING_DIMENSION=2048

# Detección de objetos (YOLO) — recorta personas/vehículos de la imagen completa
# antes de generar el embedding. Si los pesos no existen, se descargan solos.
DETECTION_MODEL_PATH=weights/yolov8n.pt
DETECTION_CONFIDENCE=0.4
DETECTION_FALLBACK_CONFIDENCE=0.15
DETECTION_IOU=0.45
DETECTION_PERSON_CLASS=0
# Clases COCO de vehículo: car=2, motorcycle=3, bus=5, truck=7
DETECTION_VEHICLE_CLASSES=2,3,5,7

# Micro-batching y CPU
BATCH_MAX_SIZE=12
BATCH_WINDOW_MS=15
CPU_THREADS=2

# Validación de imágenes
MAX_IMAGE_MB=5.0
MIN_IMAGE_WIDTH=32
MIN_IMAGE_HEIGHT=32

# GPU: false para CPU-only, true cuando haya CUDA disponible
ENABLE_GPU=false

# Timeout por request (segundos)
REQUEST_TIMEOUT=30

# Rate limiting (alto throughput para 1000 cámaras)
RATE_LIMIT_EMBED=6000/minute
RATE_LIMIT_HEALTH=240/minute
